# Frontend Environment Variables — set these in Vercel dashboard

# Backend API URL (your Render service URL)
VITE_API_BASE_URL=https://vidyasetu-backend.onrender.com/api/v1

# Supabase (public/anon key only — service role stays backend-only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base path: leave blank (defaults to '/') for Vercel
# Set to '/vidyasetu/' only for GitHub Pages
# VITE_BASE_URL=/vidyasetu/
